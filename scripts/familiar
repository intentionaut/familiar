#!/usr/bin/env python3
"""familiar - onboarding and day-to-day commands for Familiar.

Agent-neutral: works from any terminal, any AI assistant, or no assistant at
all. The prompts and knowledge files are plain markdown; this script just
scaffolds the right folders and points you at the right files.

Usage:
    familiar                       engage on the project you are standing in
    familiar engage [dir]          the same, for a named project
    familiar init                  set up Familiar in the current directory
    familiar new-piece <slug>      scaffold a new piece folder
    familiar inspire "text" --url X clip a snippet for later
    familiar harvest               scaffold patterns.md, list build logs found
    familiar decisions             every question waiting on you, in one list
    familiar decisions answer <piece> "..."   record an answer against a piece
    familiar log list              show watched projects
    familiar log add <project>     register a project and wire its log
    familiar log move <project> <to>  move the log out of the project
    familiar log entry <project>   scaffold a dated log entry
    familiar reflect               show reflection status
    familiar learn                 show knowledge file status
    familiar status                what Familiar can see and what it still needs
    familiar skill install [agent] install commands for a specific agent
"""
import argparse
import importlib.util
import json
import os
import re
import subprocess
import shutil
import sys
from datetime import date
from pathlib import Path

HOME = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HOME / "scripts"))
from paths import knowledge_dir, pieces_dirs, read_config  # noqa: E402

PRESENCE = "I'm here watching you work and will help you tell your story."


def _version():
    try:
        return json.loads((HOME / ".claude-plugin" / "plugin.json").read_text())["version"]
    except Exception:
        return "unknown"


def _digest_module():
    spec = importlib.util.spec_from_file_location("project_digest", HOME / "scripts" / "project-digest.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _git_top(path):
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=path, capture_output=True, text=True)
    return Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def _positioning_is_template():
    """True while the publication's name is still the bracketed prompt."""
    try:
        cfg, _ = knowledge_dir(None)
        f = Path(cfg) / "positioning.md"
        if not f.is_file():
            return True
        return re.search(r"^- Name: \[", f.read_text(encoding="utf-8", errors="replace"), re.M) is not None
    except Exception:
        return True


def cmd_engage(args):
    """Stand in a project and Familiar reads its history first.

    This is what `familiar` with no arguments does. The facts come from
    scripts/project-digest.py: the commits whose messages carried their
    reasoning and the ones that admit a correction. The questions under them
    are the agent's to write, so the terminal shows the facts and hands over.
    """
    target = Path(getattr(args, "dir", None) or ".").resolve()
    top = _git_top(target)
    print(PRESENCE)
    print()
    if top is None:
        print("This folder is not a git repository, so there is no history to read yet.")
        print("Stand in a project and run `familiar`, or tell your agent what you have:")
        print("a session you just finished, a draft, some notes, or an idea.")
        print()
        return cmd_status(args)
    if top == HOME:
        print("This is Familiar's own folder. Stand in a project you have built and")
        print("run `familiar`: it reads the history and finds the stories in it.")
        print()
        return cmd_status(args)

    h = _digest_module().history(top)
    name = top.name
    if not h:
        print(f"I've engaged on {name}, the project you're working on, but it has no")
        print("commits yet. Come back once it has a history, or tell your agent what")
        print("you have: a session you just finished, a draft, some notes, or an idea.")
        return 0

    print(f"I've engaged on {name}, the project you're working on. I'll study the")
    print("context and look for themes.")
    print()
    authors = len(h["authors"])
    print(f"  {len(h['commits'])} commits, {h['first']} to {h['last']}, "
          f"{authors} author{'s' if authors != 1 else ''}.")
    print(f"  {len(h['with_body'])} carried their reasoning in the message. "
          f"{len(h['turns'])} admit a correction.")
    print()
    seeds = h["with_body"][-5:] if h["with_body"] else []
    if seeds:
        print("  Where the reasoning was written down, newest last:")
        print()
        for i, c in enumerate(seeds, 1):
            body = " ".join(c["body"].split())
            if len(body) > 110:
                body = body[:107].rstrip() + "..."
            print(f"  {i}. {c['date']}  {c['subject']}")
            print(f"     {body}")
        print()
    else:
        print("  No commit message carried its reasoning. The history says what")
        print("  changed and when; the why is yours to tell.")
        print()
    if h["turns"]:
        print("  Corrections the messages admit to:")
        for c in h["turns"][-3:]:
            print(f"    {c['date']}  {c['subject']}")
        print()

    # Write the digest where the agent and harvest look for it.
    where = None
    try:
        cfg, _ = knowledge_dir(None)
        out = Path(cfg) / "digests"
        out.mkdir(parents=True, exist_ok=True)
        _, digest, *_ = _digest_module().digest_repo(top)
        (out / f"{name}.md").write_text(digest, encoding="utf-8")
        where = out / f"{name}.md"
    except Exception:
        pass

    print("  Which of these is worth telling? Say `familiar` to your agent and it")
    print("  will ask about each before anything is drafted. Or tell it what you")
    print("  had in mind.")
    if where:
        print(f"  The full digest is at {where}.")
    if _positioning_is_template():
        print()
        print("  Your voice files are still templates. positioning.md is needed")
        print("  before a draft, not before this.")
    print()
    return 0


def _today_slug(raw):
    """Normalise a slug: lowercase, hyphens for spaces/slashes, strip non-alnum."""
    import re
    slug = raw.strip().lower().replace(" ", "-").replace("/", "-")
    slug = re.sub(r"[^a-z0-9-]", "", slug)
    slug = re.sub(r"-{2,}", "-", slug).strip("-")
    return slug


def cmd_init(args):
    """Set up Familiar in the current directory."""
    cwd = Path.cwd()
    familiar_file = cwd / ".familiar"
    knowledge_dest = cwd / "knowledge"

    # 1. Create .familiar if it does not exist
    if familiar_file.is_file() and not args.force:
        print(f".familiar already exists at {familiar_file}")
        print("Use --force to overwrite.")
        return 1

    # Build the config
    lines = [
        "# Familiar config. See scripts/paths.py for the full resolution order.",
        "",
    ]

    # Knowledge: use the repo's templates as defaults
    if not knowledge_dest.is_dir():
        knowledge_dest.mkdir(parents=True, exist_ok=True)
        # Copy template knowledge files
        shipped = HOME / "knowledge"
        for f in sorted(shipped.glob("*.md")):
            shutil.copy2(f, knowledge_dest / f.name)
        # Copy subdirectories (languages, examples)
        for d in shipped.iterdir():
            if d.is_dir():
                dest_d = knowledge_dest / d.name
                dest_d.mkdir(exist_ok=True)
                for f in d.glob("*"):
                    shutil.copy2(f, dest_d / f.name)
        print(f"Copied knowledge templates to {knowledge_dest}")

    lines.append(f"knowledge = {knowledge_dest}")

    # Pieces: default to ./pieces
    pieces_dest = cwd / "pieces"
    if not pieces_dest.is_dir():
        pieces_dest.mkdir(parents=True, exist_ok=True)
        # Copy the pieces README
        readme = HOME / "pieces" / "README.md"
        if readme.is_file():
            shutil.copy2(readme, pieces_dest / "README.md")
        print(f"Created pieces folder at {pieces_dest}")

    lines.append(f"pieces = {pieces_dest}")
    lines.append("")

    familiar_file.write_text("\n".join(lines))
    print(f"Wrote {familiar_file}")

    # 2. Install the agent commands. setup.sh reports what it installed and
    # nothing else; the welcome and the next step are said once, below.
    cc_dir = Path.home() / ".claude" / "commands"
    installed = len(list(cc_dir.glob("familiar-*.md"))) if cc_dir.is_dir() else 0
    if installed == 0 or args.force:
        print()
        sys.stdout.flush()  # keep the installer's lines after ours, not before
        os.system(f"bash {HOME}/scripts/setup.sh --no-doctor")
    else:
        print()
        print(f"Agent commands already installed ({installed} commands).")
        print(f"Run `bash {HOME}/scripts/setup.sh` to reinstall.")

    # 3. The first thing after install is the project, if there is one.
    return cmd_engage(args)


def cmd_new_piece(args):
    """Scaffold a new piece folder."""
    if not args.slug:
        print("Usage: familiar new-piece <slug>")
        print("  e.g. familiar new-piece my-essay-title")
        return 1

    slug = _today_slug(args.slug)
    if not slug:
        print("Slug is empty after normalisation. Use a descriptive name.")
        return 1

    # Find where pieces live
    pieces = pieces_dirs()
    if not pieces:
        print("No pieces folder configured. Run 'familiar init' first.")
        return 1

    # Use the first pieces directory
    pieces_dir = pieces[0]
    today = date.today().isoformat()
    folder_name = f"{today}-{slug}"
    piece_dir = pieces_dir / folder_name

    if piece_dir.is_dir() and not args.force:
        print(f"Piece folder already exists: {piece_dir}")
        return 1

    piece_dir.mkdir(parents=True, exist_ok=True)

    # Create edits subfolder
    (piece_dir / "edits").mkdir(exist_ok=True)

    # Create SESSION-CONTEXT.md
    session_ctx = piece_dir / "SESSION-CONTEXT.md"
    session_ctx.write_text(
        f"# {folder_name}\n"
        f"\n"
        f"## {today} 00:00  init  {folder_name}\n"
        f"\n"
        f"Status: created\n"
        f"Files: none yet\n"
        f"What changed: piece folder created\n"
        f"Decision gate: run `familiar interview <idea>` to begin\n"
        f"Next stage: interview\n"
    )

    # Create notes.md with a starter header
    notes = piece_dir / "notes.md"
    notes.write_text(f"# {folder_name}\n\n## Thesis\n\n## Evidence\n\n## Open questions\n\n")

    print(f"Created piece folder: {piece_dir}")
    print()
    print("Next steps:")
    print(f"  1. cd {piece_dir}")
    print("  2. familiar interview <your idea>")
    print()
    print("The interview asks one question at a time and writes your")
    print("answers into notes.md. Nothing moves to the next stage until")
    print("you say so.")
    return 0


def cmd_inspire(args):
    """Clip a snippet into the inspirations folder."""
    import re
    from datetime import date

    # Find where knowledge lives (inspirations goes next to it)
    kdir, _whose = knowledge_dir()
    if not kdir:
        print("No knowledge folder configured. Run 'familiar init' first.")
        return 1

    insp_dir = kdir.parent / "inspirations"
    insp_dir.mkdir(parents=True, exist_ok=True)

    text = args.text
    url = args.url

    # Interactive mode: no text provided
    if not text:
        print("Paste the snippet (end with an empty line):")
        lines = []
        while True:
            try:
                line = input()
            except EOFError:
                break
            if line == "" and lines:
                break
            lines.append(line)
        text = "\n".join(lines)
        if not text.strip():
            print("Nothing to clip.")
            return 1
        if not url:
            url = input("URL: ").strip()
            if not url:
                print("No URL provided. Clip saved without a source.")
                url = ""

    # Generate slug from first ~5 words
    words = re.sub(r"[^a-z0-9 ]", "", text.lower()).split()[:5]
    slug = "-".join(words) if words else "clip"
    slug = re.sub(r"-{2,}", "-", slug).strip("-")

    today = date.today().isoformat()
    filename = f"{today}-{slug}.md"
    filepath = insp_dir / filename

    # Deduplicate: append -2, -3, etc. if exists
    counter = 2
    while filepath.is_file():
        filepath = insp_dir / f"{today}-{slug}-{counter}.md"
        counter += 1

    # Build the file
    title_text = " ".join(words).title() if words else "Clipped snippet"
    parts = [f"# {title_text}", ""]
    if url:
        parts.append(f"Source: {url}")
    parts.append(f"Clipped: {today}")
    parts.append("")
    # Wrap snippet in blockquote
    for line in text.strip().splitlines():
        parts.append(f"> {line}" if line.strip() else ">")
    parts.append("")

    filepath.write_text("\n".join(parts))
    print(f"Clipped to {filepath}")
    print(f"Title: {title_text}")
    if not url:
        print("(no URL provided — add one later by editing the file)")
    return 0


def cmd_harvest(args):
    """Scaffold patterns.md and list build logs found."""
    kdir, whose = knowledge_dir()
    if not kdir:
        print("No knowledge folder configured. Run 'familiar init' first.")
        return 1

    # Check for patterns.md, scaffold if missing
    patterns = kdir / "patterns.md"
    if not patterns.is_file():
        template = HOME / "knowledge" / "patterns.md"
        if template.is_file():
            import shutil
            shutil.copy2(template, patterns)
            print(f"Created {patterns}")
        else:
            patterns.write_text(
                "# Cross-project patterns\n\n"
                "## Recurring themes\n\n[run `familiar harvest` to populate]\n\n"
                "## Growth signals\n\n[run `familiar harvest` to populate]\n\n"
                "## Inspiration connections\n\n[run `familiar harvest` to populate]\n\n"
                "## Ready topics\n\n[run `familiar harvest` to populate]\n"
            )
            print(f"Created {patterns}")
    else:
        print(f"patterns.md exists: {patterns}")

    # List what harvest will read. read_settings() is the one parser for the
    # registry: a second one here reported four logs out of five, and the one
    # it dropped was the largest, because it matched only *-LOG.md filenames.
    build_logs = kdir / "build-logs.md"
    if build_logs.is_file():
        from log import read_settings
        _root, watched, _reg = read_settings()
        if watched:
            print(f"\nBuild logs registered ({len(watched)}):")
            for proj, name in watched.items():
                exists = "" if (Path(proj) / name).is_file() else "   (not found)"
                print(f"  {Path(proj).name} -> {name}{exists}")
        else:
            print("\nNo build logs registered yet.")
            print("  Start one:  familiar log add <project>")
    else:
        print(f"\nNo build-logs.md found at {build_logs}")

    # Check for inspirations. They live next to the knowledge folder, which is
    # where `familiar inspire` writes them, and not in this repo.
    insp_dir = kdir.parent / "inspirations"
    if insp_dir.is_dir():
        clips = list(insp_dir.glob("*.md"))
        clips = [c for c in clips if c.name != "README.md"]
        if clips:
            print(f"\nInspirations clipped: {len(clips)}")
        else:
            print("\nNo inspirations clipped yet.")
    else:
        print("\nNo inspirations/ folder yet.")

    print("\nThe harvest stage reads all of the above and synthesizes patterns.")
    print("Run it through your agent: /familiar-harvest or via the skill.")
    return 0


def cmd_decisions(args):
    """Every open decision gate, and a way to answer one."""
    import subprocess
    argv = ["answer", args.piece, args.answer] if args.piece else []
    return subprocess.call([sys.executable, str(HOME / "scripts" / "decisions.py"), *argv])


def cmd_log(args):
    """Handle log subcommands."""
    if args.log_command == "list":
        return cmd_log_list(args)
    elif args.log_command == "add":
        return cmd_log_add(args)
    elif args.log_command == "move":
        return _run_log_py("move", args.project, args.dest)
    elif args.log_command == "entry":
        return cmd_log_entry(args)
    else:
        print("Usage: familiar log <list|add|entry>")
        print("  list                    show watched projects")
        print("  add <project-folder>    register a project and wire its log")
        print("  move <project> <to>     move the log out of the project")
        print("  entry <project-name>    scaffold a dated log entry")
        return 1


def _run_log_py(*argv):
    """Run scripts/log.py, the one implementation of the build-log registry.

    `familiar log list|add` is the documented name; log.py is what it does.
    Two implementations of `add` used to exist and they wrote the registry line
    in different formats, so a project registered by one was invisible to the
    other. There is now one.
    """
    import subprocess
    return subprocess.call([sys.executable, str(HOME / "scripts" / "log.py"), *argv])


def cmd_log_list(args):
    """Show every project and which ones keep a build log."""
    return _run_log_py("list")


def cmd_log_add(args):
    """Register a project, create its log and wire the hooks."""
    if not args.project:
        print("Usage: familiar log add <project-folder>")
        print("  e.g. familiar log add ~/Projects/my-app")
        return 1
    return _run_log_py("add", args.project)


def cmd_log_entry(args):
    """Scaffold a dated log entry in a project's build log."""
    if not args.project:
        print("Usage: familiar log entry <project-name>")
        print("  e.g. familiar log entry my-app")
        return 1

    from log import read_settings

    _root, watched, build_logs = read_settings()
    if not build_logs.is_file():
        print(f"No build-logs.md at {build_logs}")
        return 1

    # Match the folder, its name, then anything containing what was asked for.
    log_file = None
    for match in (lambda proj, name: proj == args.project or Path(proj).name == args.project,
                  lambda proj, name: args.project in proj or args.project in name):
        for proj, name in watched.items():
            if match(proj, name) and (Path(proj) / name).is_file():
                log_file = Path(proj) / name
                break
        if log_file:
            break

    if not log_file or not log_file.is_file():
        print(f"Project '{args.project}' not found or log file missing.")
        print("Register it first with: familiar log add <project-folder>")
        return 1

    # Scaffold a new entry
    today = date.today().isoformat()
    entry = (
        f"\n## {today}\n"
        f"\n"
        f"**Shipped**\n"
        f"- \n"
        f"\n"
        f"**Decisions**\n"
        f"- \n"
        f"\n"
        f"**Went wrong**\n"
        f"- \n"
        f"\n"
        f"**Numbers**\n"
        f"- \n"
        f"\n"
        f"**Open**\n"
        f"- \n"
    )

    with open(log_file, "a") as f:
        f.write(entry)

    print(f"Appended entry for {today} to {log_file}")
    print("Fill in what shipped, what was decided, what went wrong.")
    return 0


def cmd_reflect(args):
    """Show reflection status."""
    kdir, whose = knowledge_dir()
    if not kdir:
        print("No knowledge folder configured. Run 'familiar init' first.")
        return 1

    reflection = kdir / "reflection.md"
    if not reflection.is_file():
        print(f"No reflection.md at {reflection}")
        return 0

    text = reflection.read_text()

    # Parse settings
    import re
    on_off = re.search(r"Reflection:\s*\[?(on|off)", text, re.IGNORECASE)
    cadence = re.search(r"Cadence:\s*\[?(weekly|fortnightly|monthly)", text, re.IGNORECASE)
    folder = re.search(r"Reflections live in:\s*(.+)", text)

    status = on_off.group(1).lower() if on_off else "unknown"
    cadence_val = cadence.group(1).lower() if cadence else "not set"
    folder_val = folder.group(1).strip() if folder else "not set"

    print(f"Reflection: {status}")
    print(f"Cadence: {cadence_val}")
    print(f"Folder: {folder_val}")

    if status == "off" or status == "[on / off]":
        print("\nReflection is off. Edit knowledge/reflection.md to turn it on.")
    elif cadence_val == "[weekly / fortnightly / monthly]":
        print("\nCadence is not set yet. Edit knowledge/reflection.md.")
    else:
        print("\nSay 'reflect' to your agent when you want one.")
    return 0


def cmd_learn(args):
    """Show knowledge file status."""
    kdir, whose = knowledge_dir()
    if not kdir:
        print("No knowledge folder configured. Run 'familiar init' first.")
        return 1

    files = {
        "positioning.md": "what the publication is, house rules",
        "voice-guide.md": "how the writer writes",
        "style-rules.md": "mechanical checklist for line edits",
        "social-rules.md": "the four tests a short post passes",
        "examples/canonical.md": "annotated excerpts of published work",
        "social-schedule.md": "channels, cadence, send times",
    }

    templates = HOME / "knowledge"
    print("Knowledge file status:")
    for name, desc in files.items():
        fpath = kdir / name
        tmpl = templates / name
        if fpath.is_file():
            content = fpath.read_text()
            # Check if it looks like an unfilled template
            if "[" in content and "]" in content and "##" in content:
                has_brackets = bool(re.search(r"\[.*\]", content))
                if has_brackets:
                    print(f"  {name}: template (needs filling in)")
                else:
                    print(f"  {name}: filled")
            else:
                print(f"  {name}: filled")
        else:
            print(f"  {name}: missing")

    print(f"\nKnowledge folder: {kdir}")
    if whose == "the shipped templates":
        print("(using shipped templates - run 'familiar init' to set up your own)")
    print("\nAsk your agent to 'learn' to propose rules from past writing.")
    return 0


def cmd_status(args):
    """Show what Familiar can see and what it still needs."""
    os.system(f"python3 {HOME}/scripts/doctor.py")
    return 0


AGENTS = {
    "claude": ("Claude Code", Path.home() / ".claude" / "commands"),
    "opencode": ("opencode", Path.home() / ".config" / "opencode" / "command"),
    "codex": ("Codex", Path.home() / ".codex" / "commands"),
    "gemini": ("Gemini CLI", Path.home() / ".gemini" / "commands"),
}


def cmd_skill_install(args):
    """Install /familiar-* commands for an agent."""
    agent = args.agent
    if agent == "all":
        targets = AGENTS
    elif agent in AGENTS:
        targets = {agent: AGENTS[agent]}
    else:
        print(f"Unknown agent: {agent}")
        print(f"Supported: {', '.join(sorted(AGENTS))}, all")
        return 1

    # Use setup.sh with --only for each agent
    for key, (label, dest) in targets.items():
        print(f"Installing for {label}...")
        os.system(f"bash {HOME}/scripts/setup.sh --only {key}")
    return 0


INTRO_MARKER = Path.home() / ".familiar" / "introduced"

SEEN_VERSION = Path.home() / ".familiar" / "seen-version"

INTRO = """
One thing, once. Familiar can ask you two questions at the end of a stage and
write your answers down word for word. Those answers are the rawest record of
your own voice it holds, and case-study reads them. It is off until you turn it
on: knowledge/reflection.md, two lines.

Session capture is the other loop: `familiar log add <project>` writes what
shipped as a Claude Code session ends. On another agent, keep the build log by
hand with `familiar log entry <project>`.

This is the only time the CLI will mention either.
"""


def _reflection_unset():
    """True when the writer has never set reflection on or off."""
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        from paths import knowledge_dir
        cfg, _ = knowledge_dir(None)
    except Exception:
        return True
    f = Path(cfg) / "reflection.md"
    if not f.is_file():
        return True
    text = f.read_text(encoding="utf-8", errors="replace")
    return re.search(r"^- Reflection:\s*(on|off)\s*$", text, re.M | re.I) is None


def _introduce_once():
    """Say what the two loops are, the first time the CLI does real work.

    Once, ever: a marker under ~/.familiar records that it has been said. Never
    on --help, never when reflection has already been set on or off, and never
    again after the first time, whatever the answer was. A loop nobody has
    opened is different from one that is off, and the only way a writer finds
    it otherwise is by reading a file they have no reason to open.
    """
    if INTRO_MARKER.exists() or not _reflection_unset():
        return
    try:
        INTRO_MARKER.parent.mkdir(parents=True, exist_ok=True)
        INTRO_MARKER.write_text(date.today().isoformat() + "\n")
    except OSError:
        return
    print(INTRO)


def _whats_new_once():
    """After an update, say the one thing the newest release gives you, once.

    A stamp under ~/.familiar records the last version this CLI ran as. The
    first run ever writes it silently; a run on a newer version prints the
    lead of the newest changelog bullet and moves the stamp. A release whose
    entry is "Bug fixes and updates." prints nothing. Off the beaten path this
    is how a writer who installed months ago hears about the front door.
    """
    current = _version()
    try:
        seen = SEEN_VERSION.read_text().strip() if SEEN_VERSION.exists() else None
    except OSError:
        return
    if seen == current:
        return
    try:
        SEEN_VERSION.parent.mkdir(parents=True, exist_ok=True)
        SEEN_VERSION.write_text(current + "\n")
    except OSError:
        return
    if seen is None:
        return
    lead = _newest_release_lead()
    if lead:
        print(f"New in {current}: {lead}")
        print()


def _newest_release_lead():
    """The bold lead of the first bullet under the newest changelog entry."""
    try:
        text = (HOME / "CHANGELOG.md").read_text(encoding="utf-8")
    except OSError:
        return None
    m = re.search(r"^## (\d+\.\d+\.\d+)[^\n]*\n(.*?)(?=^## \d|\Z)", text, re.M | re.S)
    if not m:
        return None
    body = m.group(2)
    b = re.search(r"^- \*\*(.+?)\*\*(.*?)(?=^- |\n\n|\Z)", body, re.M | re.S)
    if not b:
        return None
    lead = b.group(1).strip()
    rest = " ".join(b.group(2).split())
    sentence = rest.split(". ")[0].strip()
    return (lead + (" " + sentence if sentence else "")).rstrip(".") + "."


def _finish(rc):
    if rc == 0:
        _whats_new_once()
        _introduce_once()
    sys.exit(rc)


def main():
    parser = argparse.ArgumentParser(
        prog="familiar",
        description="Onboarding and day-to-day commands for Familiar.",
    )
    sub = parser.add_subparsers(dest="command")

    # engage
    p_engage = sub.add_parser("engage", help="read the project you are standing in and find the stories in its history")
    p_engage.add_argument("dir", nargs="?", default=None, help="project folder (default: here)")

    # init
    p_init = sub.add_parser("init", help="set up Familiar in the current directory")
    p_init.add_argument("--force", action="store_true", help="overwrite existing config")

    # new-piece
    p_piece = sub.add_parser("new-piece", help="scaffold a new piece folder")
    p_piece.add_argument("slug", nargs="?", help="a short slug for the piece")
    p_piece.add_argument("--force", action="store_true", help="overwrite if exists")

    # inspire
    p_inspire = sub.add_parser("inspire", help="clip a snippet for later")
    p_inspire.add_argument("text", nargs="?", help="the snippet text")
    p_inspire.add_argument("--url", help="source URL")

    # harvest
    sub.add_parser("harvest", help="scaffold patterns.md, list build logs found")

    # log
    p_dec = sub.add_parser("decisions", help="every question waiting on you")
    p_dec.add_argument("mode", nargs="?", choices=["answer"], help="record an answer")
    p_dec.add_argument("piece", nargs="?", help="the piece the answer belongs to")
    p_dec.add_argument("answer", nargs="?", help="your answer, in your words")

    p_log = sub.add_parser("log", help="manage build logs")
    p_log_sub = p_log.add_subparsers(dest="log_command")
    p_log_sub.add_parser("list", help="show watched projects")
    p_log_add = p_log_sub.add_parser("add", help="register a project and wire its log")
    p_log_add.add_argument("project", nargs="?", help="project folder path")
    p_log_move = p_log_sub.add_parser("move", help="move the log out of the project")
    p_log_move.add_argument("project", help="the project")
    p_log_move.add_argument("dest", help="destination folder or file")

    p_log_entry = p_log_sub.add_parser("entry", help="scaffold a dated log entry")
    p_log_entry.add_argument("project", nargs="?", help="project name")

    # reflect
    sub.add_parser("reflect", help="show reflection status")

    # learn
    sub.add_parser("learn", help="show knowledge file status")

    # status
    sub.add_parser("status", help="what Familiar can see and what it still needs")

    # skill install
    p_skill = sub.add_parser("skill", help="manage agent skills")
    p_skill_sub = p_skill.add_subparsers(dest="skill_command")
    p_install = p_skill_sub.add_parser("install", help="install commands for an agent")
    p_install.add_argument("agent", nargs="?", default="all",
                           help=f"agent to install for: {', '.join(sorted(AGENTS))}, all (default: all)")

    args = parser.parse_args()

    if args.command is None or args.command == "engage":
        _finish(cmd_engage(args))
    elif args.command == "init":
        _finish(cmd_init(args))
    elif args.command == "new-piece":
        _finish(cmd_new_piece(args))
    elif args.command == "inspire":
        _finish(cmd_inspire(args))
    elif args.command == "harvest":
        _finish(cmd_harvest(args))
    elif args.command == "decisions":
        return cmd_decisions(args)
    elif args.command == "log":
        _finish(cmd_log(args))
    elif args.command == "reflect":
        _finish(cmd_reflect(args))
    elif args.command == "learn":
        _finish(cmd_learn(args))
    elif args.command == "status":
        _finish(cmd_status(args))
    elif args.command == "skill" and args.skill_command == "install":
        _finish(cmd_skill_install(args))
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
